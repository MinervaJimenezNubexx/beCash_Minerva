@server=http://localhost:4004
@adminService=/odata/v4/admins
@managerService=/odata/v4/managers
@employeeService=/odata/v4/employees

### Mocked users
@userAdmin=alice
@userManager=pedro
@userEmp1=juan
@userEmp2=maria
@userEmp3=laura
@password=



### Admin tries to see the Clients Table
GET {{server}}{{adminService}}/Clients
Authorization: Basic {{userAdmin}}:{{password}}

### Employee tries to see the Clients Table
GET {{server}}{{adminService}}/Clients
Authorization: Basic {{userEmp1}}:{{password}}

//************* VIEWS ***************


// EMPLOYEES
### Total hours per project
GET {{server}}{{employeeService}}/EmployeeProjectHoursView
Authorization: Basic {{userEmp3}}:{{password}}

### Status of logged hours per project
//Managers can also access this views because they also have the employee role
GET {{server}}{{employeeService}}/EmployeeHoursStatusView
Authorization: Basic {{userEmp1}}:{{password}}

###
GET {{server}}{{employeeService}}/EmployeeHoursStatusView
Authorization: Basic {{userManager}}:{{password}}


//MANAGERS
### Total spent and budget of the projects
GET {{server}}{{managerService}}/ManagerProjectFinancesView
Authorization: Basic {{userManager}}:{{password}}

### Project budget spent per employee position
GET {{server}}{{managerService}}/SpentPerPositionView
Authorization: Basic {{userManager}}:{{password}}

### Project budget projection on what the budget will be when all hours set by the employees are approved
GET {{server}}{{managerService}}/ProjectBudgetProjectionView
Authorization: Basic {{userManager}}:{{password}}

//CREATE LOGGED HOURS

### Data Validation for LoggedHours
POST {{server}}{{employeeService}}/LoggedHours
Authorization: Basic {{userEmp1}}:{{password}}
Content-Type: application/json

{
    "quantity": 1.50, 
    "employee_ID": "33333333-3333-3333-3333-333333333333",
    "project_ID": "aaaa1111-aaaa-1111-aaaa-1111aaaa1111",
    "imputationDate": "2026-04-15",
    "status_ID": "N",
    "rejectionReason_ID": "NR",
    "isLocked": false,
    "isModifiedByAdmin": false
}

// Deactivating employees and clients

### Deactivate employee
POST {{server}}{{adminService}}/Employees(33333333-3333-3333-3333-333333333333)/AdminsService.deactivateEmployees
Authorization: Basic {{userAdmin}}:{{password}}
Content-Type: application/json

{}

### Deactivate client
POST {{server}}{{adminService}}/Clients(11111111-1111-1111-1111-111111111111)/AdminsService.deactivateClients
Authorization: Basic {{userAdmin}}:{{password}}
Content-Type: application/json

{}

// Admin modification

### Change the rejected status to approved on a log by the Admin
PATCH {{server}}{{adminService}}/LoggedHours(9999cccc-9999-cccc-9999-cccc9999cccc)
Authorization: Basic {{userAdmin}}:{{password}}
Content-Type: application/json

{
    "status_ID": "A",
    "rejectionReason_ID": "NR"
}

### See the Logs to see if the update by admin worked
GET {{server}}{{adminService}}/LoggedHours
Authorization: Basic {{userAdmin}}:{{password}}

//Employee tries to modifify status of resolved hours
###
PATCH {{server}}{{employeeService}}/LoggedHours(ffff6666-ffff-6666-ffff-6666ffff6666)
Authorization: Basic {{userEmp1}}:{{password}}
Content-Type: application/json

{
    "status_ID": "A",
    "rejectionReason_ID": "NR"
}


// Employee cannot update hours when already sent

### Update hours quantity on sent register
PATCH {{server}}{{employeeService}}/LoggedHours(7777aaaa-7777-aaaa-7777-aaaa7777aaaa)
Authorization: Basic {{userEmp2}}:{{password}}
Content-Type: application/json

{
  "quantity": 3.5
}

// Manager tries to update hours already resolved -> FAIL
###
PATCH {{server}}{{managerService}}/LoggedHours(8888bbbb-8888-bbbb-8888-bbbb8888bbbb)
Authorization: Basic {{userManager}}:{{password}}
Content-Type: application/json

{
    "status_ID": "R",
    "rejectionReason_ID": "TI"
}

// Manager approves hours pending -> OK
###
PATCH {{server}}{{managerService}}/LoggedHours(7777aaaa-7777-aaaa-7777-aaaa7777aaaa)
Authorization: Basic {{userManager}}:{{password}}
Content-Type: application/json

{
    "status_ID": "A"
}

// (RESTART SERVER FIRST) Manager rejects hours pending with no reason -> FAIL
###
PATCH {{server}}{{managerService}}/LoggedHours(7777aaaa-7777-aaaa-7777-aaaa7777aaaa)
Authorization: Basic {{userManager}}:{{password}}
Content-Type: application/json

{
    "status_ID": "R",
    "rejectionReason_ID": "NR"
}

// Manager rejects hours pending with a reason -> OK
###
PATCH {{server}}{{managerService}}/LoggedHours(7777aaaa-7777-aaaa-7777-aaaa7777aaaa)
Authorization: Basic {{userManager}}:{{password}}
Content-Type: application/json

{
    "status_ID": "R",
    "rejectionReason_ID": "LOH"
}