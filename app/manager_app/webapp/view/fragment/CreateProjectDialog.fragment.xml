<core:FragmentDefinition 
    xmlns="sap.m" 
    xmlns:core="sap.ui.core" 
    xmlns:f="sap.ui.layout.form">
    
    <Dialog title="{i18n>CreateNewProject}" contentWidth="400px">
        <f:SimpleForm editable="true" layout="ResponsiveGridLayout">
            
            <Label text="{i18n>ProjectNameDialog}" required="true"/>
            <Input id="newProjName" placeholder="{i18n>ProjectNameExample}" />

            <Label text="{i18n>ProjectClient}" required="true"/>
            <Select id="newProjClient" items="{/Clients}">
                <core:Item key="{ID}" text="{name}" />
            </Select>

            <Label text="{i18n>InitialBudget}" required="true"/>
            <Input id="newProjBudget" type="Number" placeholder="{i18n>InitialBudgetExample}" />
            
        </f:SimpleForm>
        
        <beginButton>
            <Button text="{i18n>CreateProjectButton}" type="Emphasized" press=".onSaveNewProject" />
        </beginButton>
        <endButton>
            <Button text="{i18n>CancelCreationButton}" type="Reject" press=".onCancelNewProject" />
        </endButton>
    </Dialog>
    
</core:FragmentDefinition>