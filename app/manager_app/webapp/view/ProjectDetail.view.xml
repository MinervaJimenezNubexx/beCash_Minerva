<mvc:View
    controllerName="com.nbx.managerapp.controller.ProjectDetail"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:layout="sap.ui.layout"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core">
    
    <Page id="detailPage" title="{i18n>projectDetailTitle}" showNavButton="true" navButtonPress=".onNavBack" >
        
        <headerContent>
            <Button 
                id="changeStatusButton" 
                text="{i18n>nextStatusButton}" 
                icon="sap-icon://process" 
                type="Emphasized" 
                press=".onChangeStatus"
                visible="{= %{projectStatus} !== 'C' }" />
        </headerContent>

        <content>
            <ObjectHeader
                id="objHeader"
                title="{projectName}"
                number="{
                    path: 'initialBudget',
                    type: 'sap.ui.model.type.Float',
                    formatOptions: {minFractionDigits: 2, maxFractionDigits: 2}
                }"
                numberUnit="€">
                
                <statuses>
                    <ObjectStatus title="{i18n>StatusInfo}" text="{status_description}" state="{= ${status_ID} === 'C' ? 'Error' : 'Success' }"/>
                    <ObjectStatus 
                        title="{i18n>remainingBudget}" 
                        text="{remainingBudget} €" 
                        state="{= ${remainingBudget} >= 0 ? 'Success' : 'Error' }" />
                </statuses>
                
                <attributes>
                    <ObjectAttribute title="{i18n>approvedHours}" text="{totalApprovedHours} h" />
                    <ObjectAttribute title="{i18n>totalSpent}" text="{totalSpent} €" />
                </attributes>
            </ObjectHeader>

            <IconTabBar id="iconTabBar" class="sapUiResponsiveContentPadding">
                <items>
                    <IconTabFilter key="info" text="{i18n>ProjectInfo}" icon="sap-icon://hint">
                        <VBox id="idInfoContainer" class="sapUiSmallMargin">
                            <Label text="{i18n>ProjectNameInfo}:" />
                            <Text text="{projectName}" />

                            <Label text="{i18n>ClientInfo}:" />
                            <Text text="{clientName}" />
                            
                            <Label text="{i18n>BudgetInfo}:" />
                            <Text text="{initialBudget}" />

                            <Label text="{i18n>ManagerInfo}:" />
                            <Text text="{managerFirstName} {managerLastName}" />

                            <Label text="{i18n>StatusInfo2}:" />
                            <Text text="{status_description}" />
                            
                            <Label text="{i18n>CloseDateInfo}:" />
                            <Text text="{= ${closedAt} ? ${closedAt} : ${i18n>NotClosedYet} }"/>

                            <Label text="{i18n>SentReportInfo}:" />
                            <Text text="{reportSentToClient}" />
                        </VBox>
                    </IconTabFilter>

                    <IconTabFilter key="team" text="{i18n>TeamInfo}" icon="sap-icon://group">
                        <Table id="idTeamTable" items="{employeesAssigned}"> 

                            <headerToolbar>
                                <OverflowToolbar>
                                    <Title text="{i18n>assignedEmployeesTitle}" />
                                    <ToolbarSpacer />
                                    <Button 
                                        id="addEmployeeButton" 
                                        icon="sap-icon://add" 
                                        text="{i18n>addEmployeeBtn}" 
                                        press=".onAddEmployee"
                                        visible="{= %{projectStatus} !== 'C' }" 
                                        type="Transparent"/>
                                </OverflowToolbar>
                            </headerToolbar>

                            <columns>
                                <Column><Text text="{i18n>employeeName}" /></Column>
                                <Column><Text text="{i18n>employeeEmail}" /></Column>
                                <Column><Text text="{i18n>employeePosition}" /></Column>
                                <Column hAlign="End"><Text text="" /></Column>
                            </columns>
                            <items>
                                <ColumnListItem>
                                    <cells>
                                        <Text text="{firstName} {lastName}" />
                                        <Text text="{email}" />
                                        <Text text="{position}" />
                                        <Button 
                                            icon="sap-icon://sys-minus" 
                                            text= "{i18n>removeEmployeeBtn}"
                                            type="Reject" 
                                            press=".onRemoveEmployee"
                                            visible="{= %{projectStatus} !== 'C' }"
                                             />
                                    </cells>
                                </ColumnListItem>
                            </items>
                        </Table>
                    </IconTabFilter>

                    <IconTabFilter key="hours" text="{i18n>LoggedHoursInfo}" icon="sap-icon://time-entry-request">
                        <Text text="" />
                    </IconTabFilter>

                    <IconTabFilter key="analytics" text="{i18n>ReportsInfo}" icon="sap-icon://business-objects-experience">
                        <Text text="" />
                    </IconTabFilter>

                </items>
            </IconTabBar>
        </content>
    </Page>
</mvc:View>