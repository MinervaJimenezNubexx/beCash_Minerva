<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="changeBudgetDialog" title="{i18n>ChangeBudgetTitle}">
        <content>
            <VBox class="sapUiSmallMargin">
                <Label text="{i18n>EnterNewBudget}" required="true"/>
                <Input id="newChangedBudget" type="Number" placeholder="{i18n>InitialBudgetExample}" />
            </VBox>
        </content>
        <beginButton>
            <Button text="{i18n>ConfirmChangeBudget}" type="Emphasized" press="onConfirmChangeBudget" />
        </beginButton>
        <endButton>
            <Button text="{i18n>CancelChangeBudget}" press="onCancelChangeBudget" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>