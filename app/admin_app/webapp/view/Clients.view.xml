<mvc:View controllerName="com.nbx.adminapp.controller.Clients"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="clientsViewID" title="{i18n>clientsViewTitle}" showNavButton="true" navButtonPress=".onNavBack">
        <content>
            <Table 
                id="clientsTable"
                mode="SingleSelectLeft"
                items="{
                    path: '/Clients'
                }"
                class="sapUiMediumMargin"
                width="auto">
                
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{i18n>clientsListTitle}"/>
                        <ToolbarSpacer />
                        
                        <SearchField 
                            id="searchClientField" 
                            width="350px" 
                            placeholder="{i18n>searchClient}" 
                            search=".onSearch" />
                        
                        <Button 
                            id="btnCreateClient" 
                            text="{i18n>btnCreateClient}" 
                            icon="sap-icon://add" 
                            type="Emphasized" 
                            press=".onCreatePress" />
                            
                        <Button 
                            id="btnActivateClient" 
                            text="{i18n>btnActivateClient}" 
                            icon="sap-icon://accept" 
                            type="Accept" 
                            press=".onActivatePress" />

                        <Button 
                            id="btnDeactivateClient" 
                            text="{i18n>btnDeactivateClient}" 
                            icon="sap-icon://decline" 
                            type="Reject" 
                            press=".onDeactivatePress" />
                            
                    </OverflowToolbar>
                </headerToolbar>

                <columns>
                    <Column>
                        <Text text="{i18n>clientName}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>clientEmail}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>clientNif}" />
                    </Column>
                    <Column>
                        <Text text="{i18n>clientStatus}" />
                    </Column>
                </columns>

                <items>
                    <ColumnListItem type="Navigation" press=".onClientPress">
                        <cells>
                            <ObjectIdentifier title="{name}" />
                            <Text text="{email}" />
                            <Text text="{nif}" />
                            <ObjectStatus 
                                text="{isActive}"
                                state="{= ${isActive} ? 'Success' : 'Error' }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
        </content>
    </Page>
</mvc:View>