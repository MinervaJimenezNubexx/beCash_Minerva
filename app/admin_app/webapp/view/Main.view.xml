<mvc:View controllerName="com.nbx.adminapp.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <Page id="page" title="{i18n>mainViewTitle}" class="sapUiContentPadding">
        <content>
            <FlexBox wrap="Wrap" justifyContent="Center" alignItems="Center" class="sapUiTopMargin">
                <GenericTile 
                    class="sapUiSmallMargin"
                    header="{i18n>mainViewEmployeesTileHeader}" 
                    subheader="{i18n>mainViewEmployeesTileSubheader}" 
                    press=".onNavToEmployees">
                    <TileContent>
                        <ImageContent src="sap-icon://employee" />
                    </TileContent>
                </GenericTile>

                <GenericTile
                    class="sapUiSmallMargin"
                    header="{i18n>mainViewClientsTileHeader}" 
                    subheader="{i18n>mainViewClientsTileSubheader}" 
                    press=".onNavToClients">
                    <TileContent>
                        <ImageContent src="sap-icon://customer" />
                    </TileContent>
                </GenericTile>

                <GenericTile 
                    class="sapUiSmallMargin"
                    header="{i18n>mainViewHoursTileHeader}" 
                    subheader="{i18n>mainViewHoursTileSubheader}" 
                    press=".onNavToHours">
                    <TileContent>
                        <ImageContent src="sap-icon://history" />
                    </TileContent>
                </GenericTile>

                <GenericTile 
                    class="sapUiSmallMargin"
                    header="{i18n>mainViewSettingsTileHeader}" 
                    subheader="{i18n>mainViewSettingsTileSubheader}" 
                    press=".onNavToSettings">
                    <TileContent>
                        <ImageContent src="sap-icon://action-settings" />
                    </TileContent>
                </GenericTile>
            </FlexBox>
        </content>
    </Page>
</mvc:View>