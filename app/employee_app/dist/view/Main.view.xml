<mvc:View controllerName="com.nbx.employeeapp.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m">
    
    <Page 
        id="page" 
        title="{i18n>MainTitle}">
        
        <headerContent>
            <Button 
            id="btnSendHours"
            text="{i18n>SendMonthlyHours}" 
            type="Emphasized" 
            icon="sap-icon://paper-plane"
            press=".onSendMonthlyHours" />
        </headerContent>

        <content>
            <HBox width="100%" justifyContent="Center">
                <VBox width="70%" class= "sapUiSmallMarginTop">
                    <Title text="{i18n>ProjectsTitle2}" level="H2" class= "sapUiSmallMarginBottom"/>
                    <Table id="projectsTable"
                        items="{
                            path: '/Projects',
                            parameters: {
                                $expand: 'status'
                            }
                        }"
                        noDataText="{i18n>NoProjectsAssigned}"
                        growing="true" 
                        growingThreshold="20">
                        
                        <columns>
                            <Column width="40%"><Text text="{i18n>ProjectName}" /></Column>
                            <Column width="40%"><Text text="{i18n>StatusName}" /></Column>
                        </columns>

                        <items>
                            <ColumnListItem type="Navigation" press=".onPressProject">
                                <cells>
                                    <ObjectIdentifier title="{name}" />
                                    
                                    <ObjectStatus 
                                        text="{status/description}" 
                                        state="{= 
                                            ${status_ID} === 'O' || ${status_ID} === 'D' ? 'Success' : 
                                            ${status_ID} === 'Q' || ${status_ID} === 'T' ? 'Information' : 
                                            ${status_ID} === 'C' ? 'Error' : 
                                            'None' 
                                        }" />
                                </cells>
                            </ColumnListItem>
                        </items>
                    </Table>
                </VBox>
            </HBox>
        </content>
    </Page>
</mvc:View>